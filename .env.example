# JobRadar configuration. Copy to .env and fill in.
# Only DATABASE_URL and SECRET_KEY are required; everything else is optional.
# (docker compose overrides DATABASE_URL / REDIS_URL / CORS for you.)

# --- Required -----------------------------------------------------------
# Local Postgres, or Supabase's TRANSACTION pooler URI (port 6543) in production.
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@localhost:5432/jobradar

# Signs login tokens AND encrypts stored SMTP app passwords. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the SAME value everywhere the code runs (API host + GitHub Actions secrets).
# The app refuses to start in production with a placeholder or short key.
SECRET_KEY=change-me

# --- Optional -------------------------------------------------------------
# Caching and rate limits. The app runs fine without it.
REDIS_URL=

# AI features (all optional): re-rank top matches, fill a profile from your resume,
# draft follow-ups and outreach. Either a free Gemini key...
GEMINI_API_KEY=
# ...or any OpenAI-compatible API (wins when set). Examples:
#   Ollama (local, private):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
#   Groq (free tier):         LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI:                   LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Where the web app lives (CORS + links inside emails).
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Chat alerts (Profile -> Alerts): only matches scoring at least this are pushed.
NOTIFY_MIN_SCORE=60

# "Today" for the daily outreach cap and digests.
APP_TIMEZONE=Asia/Kolkata

# Invite-only by default. Create the first admin with `python -m scripts.create_admin`.
ALLOW_REGISTRATION=false

ENVIRONMENT=development
LOG_LEVEL=INFO

# Connection pool for the API. Ingest raises its own (scripts/run_ingest.py).
# Only go above ~5 on Supabase's TRANSACTION pooler; session mode caps at 15 clients.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- System email (digests, invites, password resets) ---------------------
# smtp | resend | ses. Outreach email does NOT use this: each user connects
# their own mailbox (Gmail app password) on the Outreach page.
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Resend free tier: ~100/day. SES_FROM_EMAIL must be on a domain verified there.
RESEND_API_KEY=
SES_FROM_EMAIL=noreply@example.com
SES_FROM_NAME=JobRadar
